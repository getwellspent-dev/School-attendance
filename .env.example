# ==============================================================
# Environment Configuration Template
# ==============================================================

# 1. Super Admin Gmail Account
# Designates the primary administrator. When this Gmail signs in, they are granted ROLE_ADMIN.
ADMIN_EMAIL=getwellspent@gmail.com

# 2. Database: Supabase PostgreSQL
# Set these values in your deployment platform (Render / local .env)
# Example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-supabase-password>
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# 3. Google Gemini AI Token
# GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL=gemini-1.5-flash

# 4. Google OAuth 2.0 / Firebase Auth
# GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# 5. Security Secret
# JWT_SECRET=<your-random-secret>
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:4200,https://*.vercel.app
